<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Estratégia Shopee - PivaTelli 2025">
    <title>Shopee – Estratégia de Lançamento PivaTelli</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Lora:wght@400;500;600&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #B28CBF;
            --secondary: #7DAF9C;
            --accent: #C9A76A;
            --background: #F6F4EF;
            --text-main: #3E2E28;
            --text-light: #6B5B52;
            --border-light: rgba(201, 167, 106, 0.2 );
            --shadow-light: rgba(178, 140, 191, 0.1);
            --shadow-medium: rgba(178, 140, 191, 0.2);
            --shopee-color: #EE4D2D;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Lora', serif;
            background-color: var(--background);
            color: var(--text-main);
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Navigation */
        nav {
            position: sticky;
            top: 0;
            background: rgba(246, 244, 239, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-light);
            z-index: 1000;
            padding: 20px 0;
        }

        nav .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
            text-decoration: none;
        }

        .breadcrumb {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.85rem;
            color: var(--text-light);
        }

        .breadcrumb a {
            color: var(--secondary);
            text-decoration: none;
            margin: 0 5px;
        }

        /* Hero Section */
        .hero {
            padding: 80px 0;
            background: linear-gradient(135deg, var(--shopee-color) 0%, rgba(238, 77, 45, 0.3) 100%);
            border-left: 5px solid var(--shopee-color);
            color: white;
        }

        .hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            color: white;
            margin-bottom: 20px;
            font-weight: 700;
        }

        .hero .subtitle {
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
            color: rgba(255, 255, 255, 0.9);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 1.05rem;
            color: rgba(255, 255, 255, 0.85);
            max-width: 700px;
            line-height: 1.8;
        }

        /* Content Section */
        .content-section {
            padding: 80px 0;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            color: var(--text-main);
            margin-bottom: 40px;
            font-weight: 700;
        }

        .market-info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            margin-bottom: 60px;
        }

        .market-card {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 15px var(--shadow-light);
            border-top: 5px solid var(--shopee-color);
        }

        .market-card h3 {
            font-family: 'Montserrat', sans-serif;
            font-size: 1.1rem;
            color: var(--shopee-color);
            margin-bottom: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .market-card p {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            color: var(--text-main);
            font-weight: 700;
        }

        /* Strategy */
        .strategy-list {
            list-style: none;
            padding: 0;
            margin-bottom: 60px;
        }

        .strategy-item {
            background: white;
            border-radius: 8px;
            padding: 25px;
            margin-bottom: 20px;
            border-left: 4px solid var(--secondary);
            box-shadow: 0 2px 10px var(--shadow-light);
        }

        .strategy-item h4 {
            font-family: 'Montserrat', sans-serif;
            font-size: 1.1rem;
            color: var(--secondary);
            margin-bottom: 10px;
            font-weight: 700;
        }

        .strategy-item p {
            font-size: 0.95rem;
            color: var(--text-light);
        }

        /* Checklist */
        .checklist-container {
            background: white;
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 40px;
            border-left: 4px solid var(--accent);
            box-shadow: 0 4px 15px var(--shadow-light);
        }

        .checklist-container h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--text-main);
            margin-bottom: 25px;
            font-weight: 700;
        }

        .checklist-item {
            padding: 15px 0;
            border-bottom: 1px solid var(--border-light);
            display: flex;
            gap: 15px;
            align-items: flex-start;
        }

        .checklist-item:last-child {
            border-bottom: none;
        }

        .checklist-checkbox {
            width: 24px;
            height: 24px;
            min-width: 24px;
            cursor: pointer;
            accent-color: var(--shopee-color);
            margin-top: 2px;
        }

        .checklist-content {
            flex: 1;
        }

        .checklist-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.1rem;
            color: var(--text-main);
            margin-bottom: 5px;
            font-weight: 700;
        }

        .checklist-meta {
            font-size: 0.85rem;
            color: var(--text-light);
        }

        /* CTA Section */
        .cta-section {
            text-align: center;
            padding: 40px 0;
        }

        .cta-button {
            display: inline-block;
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
            font-weight: 600;
            padding: 18px 50px;
            background-color: var(--secondary);
            color: white;
            border: 2px solid var(--accent);
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 15px var(--shadow-light);
            margin-right: 20px;
            margin-bottom: 20px;
        }

        .cta-button:hover {
            background-color: #6a9b8a;
            transform: translateY(-3px);
            box-shadow: 0 8px 25px var(--shadow-medium);
        }

        .cta-button.secondary {
            background-color: transparent;
            color: var(--secondary);
            border-color: var(--secondary);
        }

        .cta-button.secondary:hover {
            background-color: rgba(125, 175, 156, 0.1);
        }

        /* Footer */
        footer {
            background: var(--text-main);
            color: white;
            padding: 40px 0;
            text-align: center;
            margin-top: 80px;
        }

        .footer-text {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.9rem;
            margin-bottom: 10px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .hero h1 {
                font-size: 2rem;
            }

            .market-info-grid {
                grid-template-columns: 1fr;
            }

            .cta-button {
                display: block;
                margin: 10px 0;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav>
        <div class="container">
            <a href="../index.html" class="logo">PivaTelli</a>
            <div class="breadcrumb">
                <a href="../index.html">Home</a> / <a href="index.html">Marketplaces</a> / <span>Shopee</span>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="subtitle">Marketplace</div>
            <h1>Shopee</h1>
            <p>A Shopee é um dos maiores marketplaces de varejo do Brasil, com um forte foco em preço e logística eficiente. Nossa estratégia visa a otimização de SEO e a conformidade com as regras rigorosas de cadastro.</p>
        </div>
    </section>

    <!-- Content Section -->
    <section class="content-section">
        <div class="container">
            <h2 class="section-title">Requisitos e Estratégia</h2>

            <!-- Market Info -->
            <div class="market-info-grid">
                <div class="market-card">
                    <h3>Comissão Média</h3>
                    <p>5% - 15%</p>
                </div>
                <div class="market-card">
                    <h3>Público Alvo</h3>
                    <p>Consumidores Sensíveis a Preço e Promoções</p>
                </div>
                <div class="market-card">
                    <h3>Foco Principal</h3>
                    <p>Logística, Preço e SEO de Produto</p>
                </div>
            </div>

            <!-- Strategy -->
            <h2 class="section-title">Estratégias de Sucesso</h2>
            <ul class="strategy-list">
                <li class="strategy-item">
                    <h4>Otimização de Títulos e Descrições (SEO)</h4>
                    <p>Utilize palavras-chave relevantes no título e na descrição para que o produto seja encontrado na busca interna da Shopee. O título deve ser informativo e conciso.</p>
                </li>
                <li class="strategy-item">
                    <h4>Fotos de Alta Qualidade e Fundo Branco</h4>
                    <p>A imagem principal deve ter fundo branco puro e o produto deve ocupar a maior parte da foto. Isso é crucial para a aprovação e para a credibilidade.</p>
                </li>
                <li class="strategy-item">
                    <h4>Preenchimento Completo de Especificações</h4>
                    <p>Preencha todos os campos de especificação técnica (NCM, peso, dimensões, marca) para melhorar o ranqueamento e evitar erros de frete.</p>
                </li>
                <li class="strategy-item">
                    <h4>Participação em Campanhas e Promoções</h4>
                    <p>Participe das campanhas sazonais da Shopee para aumentar a visibilidade e o volume de vendas. Ofereça cupons e combos.</p>
                </li>
            </ul>

            <!-- Checklist Específico -->
            <div class="checklist-container">
                <h3>✅ Checklist Específico da Shopee</h3>
                <div id="checklistItems">
                    <!-- Itens específicos da Shopee -->
                    <div class="checklist-item">
                        <input type="checkbox" class="checklist-checkbox">
                        <div class="checklist-content">
                            <div class="checklist-title">Título Otimizado para Busca (Máx. 120 caracteres)</div>
                            <div class="checklist-meta">Pilar 5: Comunicação | Requisito de SEO</div>
                        </div>
                    </div>
                    <div class="checklist-item">
                        <input type="checkbox" class="checklist-checkbox">
                        <div class="checklist-content">
                            <div class="checklist-title">Imagem Principal com Fundo Branco Puro</div>
                            <div class="checklist-meta">Pilar 4: Imagem | Requisito de Mídia</div>
                        </div>
                    </div>
                    <div class="checklist-item">
                        <input type="checkbox" class="checklist-checkbox">
                        <div class="checklist-content">
                            <div class="checklist-title">NCM e EAN/GTIN Preenchidos Corretamente</div>
                            <div class="checklist-meta">Pilar 3: Detalhes | Requisito Fiscal</div>
                        </div>
                    </div>
                    <div class="checklist-item">
                        <input type="checkbox" class="checklist-checkbox">
                        <div class="checklist-content">
                            <div class="checklist-title">Certificado ANVISA ou Notificação Anexada</div>
                            <div class="checklist-meta">Pilar 2: Qualidade | Requisito Legal</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CTA Section -->
            <div class="cta-section">
                <a href="../checklist/checklist-completo.html" class="cta-button">Acessar Checklist Completo</a>
                <a href="index.html" class="cta-button secondary">Ver Outros Marketplaces</a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container">
            <p class="footer-text">PivaTelli – Naturalmente científica, humanamente pura</p>
            <p class="footer-text">&copy; 2025 Lançamento Digital Profissional</p>
        </div>
    </footer>
</body>
</html>
